pipeline {
    agent any

    tools {
        maven 'M2_HOME'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        EXAMPLE_VAR = 'dev'
        NEXUS_REPO_URL = "http://127.0.0.1:8081/repository/maven-releases/"
        MAVEN_SETTINGS = "/usr/share/maven/conf/settings.xml"
        DOCKER_IMAGE_NAME = "oussabd/abdellaouioussema-g2-4twin2:latest"
        ANGULAR_IMAGE_NAME = "oussabd/angular-kaddem-frontend:latest"
    }

    stages {

        stage('Checkout Code') {
            steps {
                script {
                    try {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: 'AbdellaouiOussema-4TWIN2-G2']],
                            userRemoteConfigs: [[url: 'https://github.com/Nouunouu/4TWIN2-G6-KADDEM.git']]
                        ])
                    } catch (e) {
                        echo "Failed to checkout code: ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('Backend Build') {
            steps {
                script {
                    try {
                        sh 'cd kaddem/kaddem && mvn clean install -DskipTests'
                    } catch (e) {
                        echo "Backend build failed: ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('Backend Testing') {
            steps {
                script {
                    try {
                        sh 'cd kaddem/kaddem && mvn test'
                    } catch (e) {
                        echo "Tests failed: ${e.message}"
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    try {
                        sh 'cd kaddem/kaddem && mvn sonar:sonar -Dsonar.token=squ_a6ab247cf9bcba1c053271d3239cf41966f27b63 -DskipTests'
                    } catch (e) {
                        echo "SonarQube analysis failed: ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('Deploy Backend to Nexus') {
            steps {
                script {
                    try {
                        sh "cd kaddem/kaddem && mvn deploy --settings ${MAVEN_SETTINGS} -DskipTests"
                    } catch (e) {
                        echo "Deployment to Nexus failed: ${e.message}"
                    }
                }
            }
        }

        stage('Build Backend Docker Image') {
            steps {
                script {
                    try {
                        sh 'cd kaddem/kaddem && docker build -t abdellaouioussema-g2-4twin2:latest .'
                    } catch (e) {
                        echo "Backend Docker image build failed: ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('Build Angular App') {
            steps {
                script {
                    try {
                        sh '''
                            cd kaddem/kaddem-frontend
                            npm install
                            npm run build --prod
                        '''
                    } catch (e) {
                        echo "Angular build failed: ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('Build Angular Docker Image') {
            steps {
                script {
                    try {
                        sh 'cd kaddem/kaddem-frontend && docker build -t angular-kaddem-frontend:latest .'
                    } catch (e) {
                        echo "Angular Docker image build failed: ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('Docker Compose Up') {
            steps {
                script {
                    try {
                        sh '''
                            cd kaddem/kaddem

                            echo "Stopping and removing old containers..."
                            docker compose down --remove-orphans

                            echo "Rebuilding and starting containers..."
                            docker compose build
                            docker compose up -d
                            docker compose ps
                        '''
                    } catch (e) {
                        echo "Docker Compose failed: ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('Push Docker Images') {
            steps {
                script {
                    try {
                        withCredentials([usernamePassword(
                            credentialsId: 'dockerhub-credentials',
                            usernameVariable: 'DOCKER_USERNAME',
                            passwordVariable: 'DOCKER_PASSWORD'
                        )]) {
                            sh """
                                echo "Logging into Docker Hub..."
                                echo "\$DOCKER_PASSWORD" | docker login -u "\$DOCKER_USERNAME" --password-stdin

                                echo "Tagging backend image..."
                                docker tag abdellaouioussema-g2-4twin2:latest ${DOCKER_IMAGE_NAME}
                                docker push ${DOCKER_IMAGE_NAME}

                                echo "Tagging Angular image..."
                                docker tag angular-kaddem-frontend:latest ${ANGULAR_IMAGE_NAME}
                                docker push ${ANGULAR_IMAGE_NAME}
                            """
                        }
                    } catch (e) {
                        echo "Docker image push failed: ${e.message}"
                        throw e
                    }
                }
            }
        }
    }

    post {
        success {
            echo "===== Pipeline executed successfully ====="
        }
        failure {
            echo "====== Pipeline execution failed ======"
        }
    }
}
