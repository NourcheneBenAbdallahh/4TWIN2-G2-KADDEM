pipeline {
    agent any

    tools {
        jdk 'JAVA_HOME'
        maven 'M2_HOME'
    }

    environment {
        DB_URL = 'jdbc:mysql://localhost:3306/db'
        NEXUS_REPO_URL = "http://127.0.0.1:8081/repository/maven-releases/"
        MAVEN_SETTINGS = "/usr/share/maven/conf/settings.xml"
        DOCKER_IMAGE_NAME = "hadilbouhachem12/hadilbouhachem-4twin2-g6-kaddem:latest"
