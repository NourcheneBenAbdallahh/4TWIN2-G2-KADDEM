pipeline {
    agent any
    tools {
        maven 'M2_HOME'
    }
    options {
        timeout(time: 30, unit: 'MINUTES')
    }
    environment {
        APP_ENV = "DEV"
        NEXUS_REPO_URL = "http://127.0.0.1:8081/repository/maven-releases/"
        MAVEN_SETTINGS = "/usr/share/maven/conf/settings.xml"
        DOCKER_IMAGE_NAME = "oussemajridi/oussemajridi-4twin2-g6-kaddem:latest" // Update with your Docker Hub username and repository name
    }
    stages {
        stage('Checkout Code') {
            steps {
                script {
                    try {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: 'Oussema']],
                            userRemoteConfigs: [[url: 'https://github.com/Nouunouu/DevopsProject.git']]
                        ])
                    } catch (Exception e) {
                        echo "Failed to checkout code: ${e.message}"
                        throw e // Rethrow to fail the pipeline if checkout fails
                    }
                }
            }
        }
        stage('Code Build') {
            steps {
                script {
                    try {
                        sh '''
                            cd kaddem/kaddem
                            mvn clean install -DskipTests
                        '''
                    } catch (Exception e) {
                        echo "Code build failed: ${e.message}"
                        throw e // Rethrow to fail the pipeline if build fails
                    }
                }
            }
        }
        stage('Testing') {
            steps {
                script {
                    try {
                        sh '''
                            cd kaddem/kaddem
                            mvn test
                        '''
                    } catch (Exception e) {
                        echo "Tests failed: ${e.message}"
                        // Do not rethrow to allow pipeline to continue
                    }
                }
            }
        }
        stage('SonarQube') {
            steps {
                script {
                    try {
                        sh '''
                            cd kaddem/kaddem
                            mvn sonar:sonar -Dsonar.token=squ_75ec5f123179a9c2f52a8d9c5ae0095c0fc883a6 -DskipTests
                        '''
                    } catch (Exception e) {
                        echo "SonarQube analysis failed: ${e.message}"
                        throw e // Rethrow to fail the pipeline if SonarQube fails
                    }
                }
            }
        }
        stage('Deploy to Nexus') {
            steps {
                script {
                    try {
                        sh '''
                            cd kaddem/kaddem
                            mvn deploy --settings ${MAVEN_SETTINGS} -DskipTests
                        '''
                    } catch (Exception e) {
                        echo "Deployment to Nexus failed: ${e.message}"
                    }
                }
            }
        }
        stage('Docker Compose') {
            steps {
                script {
                    try {
                        sh '''
                            cd kaddem/kaddem
                            sudo docker-compose down
                            sudo docker-compose build
                            sudo docker-compose up -d
                            sudo docker-compose ps
                        '''
                    } catch (Exception e) {
                        echo "Docker Compose failed: ${e.message}"
                        throw e // Rethrow to fail the pipeline if Docker Compose fails
                    }
                }
            }
        }
        stage('Push Docker Image to Docker Hub') {
            steps {
                script {
                    try {
                        // Log in to Docker Hub using the existing credentials
                        withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKERHUB_USERNAME', passwordVariable: 'DOCKERHUB_PASSWORD')]) {
                            sh '''
                                echo "Logging into Docker Hub..."
                                echo "${DOCKERHUB_PASSWORD}" | sudo docker login -u "${DOCKERHUB_USERNAME}" --password-stdin
                            '''
                        }
                        // Tag the Docker image
                        sh '''
                            IMAGE_NAME="${DOCKER_IMAGE_NAME}"
                            echo "Tagging image..."
                            sudo docker tag spring-app:latest \$IMAGE_NAME
                        '''
                        // Push the Docker image to Docker Hub
                        sh '''
                            IMAGE_NAME="${DOCKER_IMAGE_NAME}"
                            echo "Pushing image to Docker Hub..."
                            sudo docker push \$IMAGE_NAME
                        '''
                    } catch (Exception e) {
                        echo "Failed to push Docker image to Docker Hub: ${e.message}"
                    }
                }
            }
        }
    }
    post {
        success {
            echo "===== Pipeline executed successfully ====="
        }
        failure {
            echo "====== Pipeline execution failed ======"
        }
    }
}