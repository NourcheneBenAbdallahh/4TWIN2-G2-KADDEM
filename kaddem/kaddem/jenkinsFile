pipeline {
    agent {
        node {
            label 'slave_build'
        }
    }

    tools {
        maven 'M2_HOME'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        EXAMPLE_VAR = 'dev'
        NEXUS_REPO_URL = "http://127.0.0.1:8081/repository/maven-releases/"
        MAVEN_SETTINGS = "C:\\Users\\admin\\.m2\\settings.xml" // Update path if needed
        DOCKER_IMAGE_NAME = "oussabd/abdellaouioussema-g2-4twin2:latest"
    }

    stages {
        stage('Checkout Code') {
            steps {
                script {
                    try {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: 'AbdellaouiOussema-4TWIN2-G2']],
                            userRemoteConfigs: [[url: 'https://github.com/Nouunouu/4TWIN2-G6-KADDEM.git']]
                        ])
                    } catch (e) {
                        echo "Failed to checkout code: ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('Build and Test') {
            steps {
                script {
                    def mvnHome = tool 'M2_HOME'
                    try {
                        bat "cd kaddem\\kaddem && call ${mvnHome}\\bin\\mvn clean install"
                    } catch (e) {
                        echo "Build failed: ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('SonarQube') {
            steps {
                script {
                    def mvnHome = tool 'M2_HOME'
                    try {
                        withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                            bat "cd kaddem\\kaddem && call ${mvnHome}\\bin\\mvn sonar:sonar -Dsonar.token=%SONAR_TOKEN% -DskipTests"
                        }
                    } catch (e) {
                        echo "SonarQube analysis failed: ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                script {
                    def mvnHome = tool 'M2_HOME'
                    try {
                        bat "cd kaddem\\kaddem && call ${mvnHome}\\bin\\mvn deploy --settings \"%MAVEN_SETTINGS%\" -DskipTests"
                    } catch (e) {
                        echo "Deployment to Nexus failed: ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('Docker Compose') {
            steps {
                script {
                    try {
                        bat '''
                            cd kaddem\\kaddem

                            echo Stopping and removing existing containers...
                            docker compose down --remove-orphans

                            echo Removing existing Prometheus and Grafana containers...
                            docker rm -f my-prometheus-container || echo "Not found"
                            docker rm -f grafana || echo "Not found"

                            echo Rebuilding and starting containers...
                            docker compose build
                            docker compose up -d
                            docker compose ps
                        '''
                    } catch (e) {
                        echo "Docker Compose failed: ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('Push Docker Image to Docker Hub') {
            steps {
                script {
                    try {
                        withCredentials([usernamePassword(
                            credentialsId: 'dockerhub-credentials',
                            usernameVariable: 'DOCKER_USERNAME',
                            passwordVariable: 'DOCKER_PASSWORD'
                        )]) {
                            bat """
                                echo Logging into Docker Hub...
                                echo %DOCKER_PASSWORD% | docker login -u %DOCKER_USERNAME% --password-stdin

                                echo Tagging Docker image...
                                docker tag abdellaouioussema-g2-4twin2:latest %DOCKER_IMAGE_NAME%

                                echo Pushing Docker image to Docker Hub...
                                docker push %DOCKER_IMAGE_NAME%
                            """
                        }
                    } catch (e) {
                        echo "Failed to push Docker image to Docker Hub: ${e.message}"
                        throw e
                    }
                }
            }
        }
    }

    post {
        success {
            echo "===== Pipeline executed successfully ====="
        }
        failure {
            echo "====== Pipeline execution failed ======"
        }
    }
}
