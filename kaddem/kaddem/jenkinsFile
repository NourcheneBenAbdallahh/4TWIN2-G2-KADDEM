pipeline {
    agent any
    tools {
        maven 'M2_HOME'
    }
    options {
        timeout(time: 30, unit: 'MINUTES')
    }
    environment {
        EXAMPLE_VAR = 'dev'
        NEXUS_REPO_URL = "http://127.0.0.1:8081/repository/maven-releases/"
        MAVEN_SETTINGS = "/usr/share/maven/conf/settings.xml"
        DOCKER_IMAGE_NAME = "oussabd/abdellaouioussema-g2-4twin2:latest" // Update with your Docker Hub username and repository name

    }
    stages {
        stage('Checkout Code') {
            steps {
                script {
                    try {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: 'AbdellaouiOussema-4TWIN2-G2']],
                            userRemoteConfigs: [[url: 'https://github.com/Nouunouu/4TWIN2-G6-KADDEM.git']]
                        ])
                    } catch (Exception e) {
                        echo "Failed to checkout code: ${e.message}"
                        throw e
                    }
                }
            }
        }
        stage('Code Build') {
            steps {
                script {
                    try {
                        sh '''
                            cd kaddem/kaddem
                            mvn clean install -DskipTests
                        '''
                    } catch (Exception e) {
                        echo "Code build failed: ${e.message}"
                        throw e
                    }
                }
            }
        }
        stage('Testing') {
            steps {
                script {
                    try {
                        sh '''
                            cd kaddem/kaddem
                            mvn test
                        '''
                    } catch (Exception e) {
                        echo "Tests failed: ${e.message}"
                    }
                }
            }
        }
         stage('SonarQube') {
            steps {
                script {
                    try {
                        sh '''
                            cd kaddem/kaddem
                            mvn sonar:sonar -Dsonar.token=squ_a6ab247cf9bcba1c053271d3239cf41966f27b63 -DskipTests
                        '''
                    } catch (Exception e) {
                        echo "SonarQube analysis failed: ${e.message}"
                        throw e 
                    }
                }
            }
        }
        stage('Deploy to Nexus') {
            steps {
                script {
                    try {
                        sh '''
                            cd kaddem/kaddem
                            mvn deploy --settings ${MAVEN_SETTINGS} -DskipTests
                        '''
                    } catch (Exception e) {
                        echo "Deployment to Nexus failed: ${e.message}"
                    }
                }
            }
        }
        stage('Build JAR') {
            steps {
                script {
                    try {
                        sh '''
                            cd kaddem/kaddem
                            mvn clean install -DskipTests
                        '''
                    } catch (Exception e) {
                        echo "JAR build failed: ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('Docker Compose') {
            steps {
                script {
                    try {
                        sh '''
                            cd kaddem/kaddem
                            docker compose build
                            docker compose up -d
                            docker compose ps
                        '''
                    } catch (Exception e) {
                        echo "Docker Compose failed: ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('Push Docker Image to Docker Hub') {
        steps {
            script {
                try {
                        withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKERHUB_USERNAME', passwordVariable: 'DOCKERHUB_PASSWORD')]) {
                            sh '''
                                echo "Logging into Docker Hub..."
                                echo "$DOCKERHUB_PASSWORD" | docker login -u "$DOCKERHUB_USERNAME" --password-stdin

                                IMAGE_NAME="${DOCKER_IMAGE_NAME}"
                                echo "Tagging image as $IMAGE_NAME..."
                                docker tag oussemajridi-4twin2-g6-kaddem:latest $IMAGE_NAME

                                echo "Pushing image to Docker Hub..."
                                docker push $IMAGE_NAME
                            '''
                        }
                    } catch (Exception e) {
                    echo "Failed to push Docker image to Docker Hub: ${e.message}"
                    throw e
                    }
                }
            }
        }



    }

    post {
        success {
            echo "===== Pipeline executed successfully ====="
        }
        failure {
            echo "====== Pipeline execution failed ======"
        }
    }
}
