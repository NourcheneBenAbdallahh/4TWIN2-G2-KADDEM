pipeline {
    agent any

    tools { 
        jdk 'JAVA_HOME' 
        maven 'M2_HOME' 
    }

    environment {

    }
    
   
   stages {
        stage('Checkout Code') {
            steps {
                script {
                    try {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: 'hadil']],
                            userRemoteConfigs: [[url: 'https://github.com/Nouunouu/DevopsProject.git']]
                        ])
                    } catch (Exception e) {
                        throw e  
                    }
                }
            }
        }
       

       stage('Code Build') {
            steps {
                script {
                    try {
                        sh '''
                            cd kaddem/kaddem
                            mvn clean install -DskipTests
                        '''
                    } catch (Exception e) {
                        
                        throw e 
                    }
                }
            }
        }
}
}
