pipeline {
    agent any

    tools { 
        jdk 'JAVA_HOME' 
        maven 'M2_HOME' 
    }

    stages {
        stage('Checkout Code') {
            steps {
                // Récupération du code source depuis le dépôt DevopsProject
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: 'hadil']],
                    userRemoteConfigs: [[url: 'https://github.com/Nouunouu/4TWIN2-G6-KADDEM.git']]
                ])
            }
        }

        stage('Code Build') {
            steps {
                // Compilation du projet avec Maven
                sh '''
                    cd kaddem/kaddem || exit 1
                    mvn clean install -DskipTests
                '''
            }
        }
    }
}
