pipeline {
    agent any

    tools {
        maven 'M2_HOME' // Assurez-vous que 'M2_HOME' est configuré dans Jenkins
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        DOCKER_IMAGE_NAME = 'ebtihel352/4twin2-g6-kaddem:latest'
    }

    stages {
        stage('Checkout Code') {
            steps {
                script {
                    try {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: 'ebtihel']],
                            userRemoteConfigs: [[url: 'https://github.com/Nouunouu/DevopsProject.git']]
                        ])
                    } catch (Exception e) {
                        error "Échec du checkout du code : ${e.message}"
                    }
                }
            }
        }

        stage('Code Build') {
            steps {
                script {
                    try {
                        sh 'mvn clean install -DskipTests'
                    } catch (Exception e) {
                        error "Échec de la compilation : ${e.message}"
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    try {
                        sh '''
                            echo "Construction de l'image Docker..."
                            sudo docker build -t kaddem:latest .
                        '''
                    } catch (Exception e) {
                        error "Échec de la construction de l'image Docker : ${e.message}"
                    }
                }
            }
        }

        stage('Push Docker Image to Docker Hub') {
            steps {
                script {
                    try {
                        // Vérifier les images locales
                        sh 'sudo docker images'

                        // Connexion à Docker Hub
                        withCredentials([usernamePassword(
                            credentialsId: 'dockerhub-credentials',
                            usernameVariable: 'DOCKERHUB_USERNAME',
                            passwordVariable: 'DOCKERHUB_PASSWORD'
                        )]) {
                            sh '''
                                echo "Connexion à Docker Hub..."
                                echo "$DOCKERHUB_PASSWORD" | sudo docker login -u "$DOCKERHUB_USERNAME" --password-stdin
                            '''
                        }

                        // Tagger l'image
                        sh """
                            echo "Taggage de l'image..."
                            sudo docker tag kaddem:latest ${env.DOCKER_IMAGE_NAME}
                        """

                        // Pousser l'image
                        sh """
                            echo "Pousser l'image vers Docker Hub..."
                            sudo docker push ${env.DOCKER_IMAGE_NAME}
                        """
                    } catch (Exception e) {
                        error "Échec de la poussée de l'image Docker vers Docker Hub : ${e.message}"
                    }
                }
            }
        }

        stage('Testing') {
            steps {
                script {
                    try {
                        sh 'mvn test'
                    } catch (Exception e) {
                        error "Échec des tests : ${e.message}"
                    }
                }
            }
        }
    }

    post {
        success {
            echo "===== Pipeline exécuté avec succès ====="
        }
        failure {
            echo "===== Échec de l'exécution du pipeline ====="
        }
    }
}