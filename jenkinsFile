pipeline {
    agent any
    tools {
        maven 'M2_HOME'
    }
    options {
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        stage('Checkout Code') {
            steps {
                script {
                    try {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: 'ebtihel']],
                            userRemoteConfigs: [[url: 'https://github.com/Nouunouu/DevopsProject.git']]
                        ])
                    } catch (Exception e) {
                        echo "Failed to checkout code: ${e.message}"
                        throw e
                    }
                }
            }
        }
        stage('Code Build') {
            steps {
                script {
                    try {
                        sh '''
                            cd 4TWIN2-G6-KADDEM/kaddem/kaddem
                            mvn clean install -DskipTests
                        '''
                    } catch (Exception e) {
                        echo "Code build failed: ${e.message}"
                        throw e
                    }
                }
            }
        }
        stage('Testing') {
            steps {
                script {
                    try {
                        sh '''
                            cd 4TWIN2-G6-KADDEM/kaddem/kaddem
                            mvn test
                        '''
                    } catch (Exception e) {
                        echo "Tests failed: ${e.message}"
                        // On ne relance pas l'erreur pour permettre à la pipeline de continuer
                    }
                }
            }
        }
    }

    post {
        success {
            echo "===== Pipeline executed successfully ====="
        }
        failure {
            echo "====== Pipeline execution failed ======"
        }
    }
}
