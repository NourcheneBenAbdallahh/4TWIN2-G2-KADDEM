pipeline {
    agent any

    tools {
        maven 'M2_HOME' // Assurez-vous que 'M2_HOME' est configuré dans Jenkins
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        stage('Checkout Code') {
            steps {
                script {
                    try {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: 'ebtihel']],
                            userRemoteConfigs: [[url: 'https://github.com/NourcheneBenAbdallahh/4TWIN2-G2-KADDEM.git']]
                        ])
                    } catch (Exception e) {
                        echo "Échec du checkout du code : ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('Code Build') {
            steps {
                script {
                    try {
                        sh 'mvn clean install -DskipTests'
                    } catch (Exception e) {
                        echo "Échec de la compilation : ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    try {
                        sh '''
                            echo "Construction de l'image Docker..."
                            docker build -t kaddem:latest .
                        '''
                    } catch (Exception e) {
                        echo "Échec de la construction de l'image Docker : ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('Push Docker Image to Docker Hub') {
            steps {
                script {
                    try {
                        def DOCKER_IMAGE_NAME = 'ebtihel352/4twin2-g6-kaddem:latest'
                        sh 'docker images'
                        withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKERHUB_USERNAME', passwordVariable: 'DOCKERHUB_PASSWORD')]) {
                            sh '''
                                echo "Connexion à Docker Hub..."
                                echo "$DOCKERHUB_PASSWORD" | docker login -u "$DOCKERHUB_USERNAME" --password-stdin
                            '''
                        }
                        sh """
                            echo "Taggage de l'image..."
                            docker tag kaddem:latest ${DOCKER_IMAGE_NAME}
                        """
                        sh """
                            echo "Pousser l'image vers Docker Hub..."
                            docker push ${DOCKER_IMAGE_NAME}
                        """
                    } catch (Exception e) {
                        echo "Échec de la poussée de l'image Docker vers Docker Hub : ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('Publish to Nexus Repository Manager') {
            steps {
                script {
                    pom = readMavenPom file: "pom.xml";
                    filesByGlob = findFiles(glob: "target/*.${pom.packaging}");
                    echo "${filesByGlob[0].name} ${filesByGlob[0].path} ${filesByGlob[0].directory} ${filesByGlob[0].length} ${filesByGlob[0].lastModified}"
                    artifactPath = filesByGlob[0].path;
                    artifactExists = fileExists artifactPath;
                    if(artifactExists) {
                        echo "*** File: ${artifactPath}, group: ${pom.groupId}, packaging: ${pom.packaging}, version ${pom.version}";
                        nexusArtifactUploader(
                            nexusVersion: 'nexus3',
                            protocol: 'http',
                            nexusUrl: '192.168.33.10:8081',
                            groupId: pom.groupId,
                            version: pom.version,
                            repository: 'maven-central-repository',
                            credentialsId: 'NEXUS_CRED',
                            artifacts: [
                                [artifactId: pom.artifactId,
                                classifier: '',
                                file: artifactPath,
                                type: pom.packaging],
                                [artifactId: pom.artifactId,
                                classifier: '',
                                file: "pom.xml",
                                type: "pom"]
                            ]
                        );
                    } else {
                        error "*** File: ${artifactPath}, could not be found";
                    }
                }
            }
        }

        stage('Testing') {
            steps {
                script {
                    try {
                        sh 'mvn test'
                    } catch (Exception e) {
                        echo "Échec des tests : ${e.message}"
                        throw e
                    }
                }
            }
        }
    }

    post {
        success {
            echo "===== Pipeline exécuté avec succès ====="
        }
        failure {
            echo "===== Échec de l'exécution du pipeline ====="
        }
    }
}