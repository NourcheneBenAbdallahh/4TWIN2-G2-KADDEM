pipeline {
    agent any

    tools {
        maven 'M2_HOME'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '5'))  // Garde seulement les 5 derniers builds
    }

    environment {
        DOCKER_IMAGE_NAME = 'ebtihel352/ebtihel-kaddem'
        COMPOSE_PROJECT_NAME = 'kaddem'  // Pour éviter les conflits de noms
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: 'ebtihel']],
                    extensions: [
                        [$class: 'CleanBeforeCheckout'],  // Nettoie le workspace avant
                        [$class: 'RelativeTargetDirectory', relativeTargetDir: 'kaddem']  // Clone dans un sous-dossier
                    ],
                    userRemoteConfigs: [[url: 'https://github.com/Nouunouu/DevopsProject.git']]
                ])
            }
        }

        stage('Code Build') {
            steps {
                dir('kaddem/kaddem') {  // Se place dans le bon répertoire
                    sh 'mvn clean package -DskipTests'
                    archiveArtifacts artifacts: 'target/*.jar', fingerprint: true  // Archive le JAR
                }
            }
        }

        stage('Testing') {
            steps {
                dir('kaddem/kaddem') {
                    sh 'mvn test'
                    junit 'target/surefire-reports/**/*.xml'  // Publie les résultats des tests
                }
            }
        }

        stage('Verify Docker') {
            steps {
                script {
                    try {
                        sh '''
                            # Vérifie Docker et Docker Compose
                            docker --version || { echo "ERROR: Docker non installé"; exit 1; }
                            docker compose version || { echo "ERROR: Docker Compose non installé"; exit 1; }

                            # Vérifie la connexion au daemon Docker
                            docker ps > /dev/null || { echo "ERROR: Impossible de se connecter au daemon Docker"; exit 1; }
                        '''
                    } catch (Exception e) {
                        error "Échec de la vérification Docker: ${e.message}"
                    }
                }
            }
        }

        stage('Docker Build & Deploy') {
            steps {
                dir('kaddem/kaddem') {
                    script {
                        try {
                            // Build l'image Docker
                            sh 'docker build -t ${DOCKER_IMAGE_NAME} .'

                            // Déploiement avec Docker Compose
                            sh '''
                                docker compose down --remove-orphans || true
                                docker compose build --no-cache
                                docker compose up -d
                                sleep 10  # Attente pour le démarrage des services
                                docker compose ps
                            '''
                        } catch (Exception e) {
                            error "Échec du déploiement Docker: ${e.message}"
                        }
                    }
                }
            }
        }

        stage('Push to Docker Hub') {
            when {
                expression { currentBuild.resultIsBetterOrEqualTo('SUCCESS') }
            }
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-creds',  // À créer dans Jenkins
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_PWD'
                    )]) {
                        sh '''
                            echo "${DOCKERHUB_PWD}" | docker login -u "${DOCKERHUB_USER}" --password-stdin
                            docker push ${DOCKER_IMAGE_NAME}
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            echo "Nettoyage des ressources..."
            script {
                sh 'docker compose -f kaddem/kaddem/docker-compose.yml down --remove-orphans || true'
                cleanWs()  // Nettoie le workspace
            }
        }
        success {
            echo "✅ Pipeline exécuté avec succès ✅"
            // slackSend(color: 'good', message: "Build ${env.BUILD_NUMBER} réussi")
        }
        failure {
            echo "❌ Échec du pipeline ❌"
            // slackSend(color: 'danger', message: "Échec du build ${env.BUILD_NUMBER}")
        }
    }
}